# CoastGuard Backend Environment Variables
# Copy this file to .env and fill in your real values

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3003
NODE_ENV=development

# ── MongoDB Connection ────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/coastguard
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/coastguard?retryWrites=true&w=majority

# ── Twilio Voice Call - AI Disaster Reporter ──────────────────────────────────
# Get credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Gemini AI (Google) ────────────────────────────────────────────────────────
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Use Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Sender name shown in the email From field
EMAIL_FROM_NAME=CoastGuard AI Alert System

# ── Authority Email Addresses ─────────────────────────────────────────────────
# Comma-separated list of emails to notify on every report
AUTHORITY_EMAILS=ndrf@example.gov.in,coastguard@example.gov.in,disaster.management@example.gov.in
